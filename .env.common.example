# Shared base configuration for all mautic-cronjobs variants.
# Copy this file to .env.common and keep only values here that are identical
# for cron, SES worker, hit worker and the generic daemon worker.

# PHP interpreter with defined memory limit, check your environment
PHP_INTERPRETER="php8.3 -d memory_limit=1G"

# Path to the Mautic console
PATH_TO_CONSOLE="../public/bin/console"
