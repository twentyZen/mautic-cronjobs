# Generic Mautic daemon worker example:
# Use this when queue consumption is managed by systemd/supervisor instead of cron.
# This variant keeps the existing rate-limited consume pattern without relying on etailors-specific SES throttling.

# Copy this file to .env.daemon and combine it with .env.common.

# Dedicated worker log directory
DAEMON_LOG_DIR="./logs/worker"
MAX_DAEMON_LOGS=10
DAEMON_LOCKFILE="./daemon-worker.lock"

# Queue processing variables for long-running daemon mode
# Recommended conservative start values:
# 14 emails per consume cycle, up to 1 second per cycle, then 1 second pause.
# This mirrors the classic cron throttling model in a persistent worker process.
DAEMON_EMAILS_PER_BATCH=14
DAEMON_QUEUE_TIME_LIMIT=1
DAEMON_QUEUE_DELAY=1
DAEMON_MEMORY_LIMIT=512M
