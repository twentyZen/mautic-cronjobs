[Unit]
Description=Mautic hit/tracking queue worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/mautic-cronjobs
ExecStart=/opt/mautic-cronjobs/mautic_hit_daemon.sh
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
