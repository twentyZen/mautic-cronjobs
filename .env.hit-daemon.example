# Hit/tracking daemon worker example:
# Use this when hit processing is moved to messenger transport "hit".
# Copy this file to .env.hit-daemon and combine it with .env.common.
#
# Expected matching Mautic config/local.php transport:
# 'messenger_dsn_hit' => 'doctrine://default?queue_name=hit',

# Dedicated worker lockfile and log directory
HIT_DAEMON_LOCKFILE="./hit-daemon-worker.lock"
HIT_DAEMON_LOG_DIR="./logs/hit-worker"
MAX_HIT_DAEMON_LOGS=10

# Conservative defaults for asynchronous tracking workloads.
# The worker consumes transport name "hit", so the Doctrine transport should
# use queue_name=hit.
HIT_DAEMON_MEMORY_LIMIT="256M"
HIT_DAEMON_TIME_LIMIT=3600
