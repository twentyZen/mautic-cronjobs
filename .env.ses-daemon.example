# SES-plugin daemon worker example:
# Use this when queue consumption is managed by systemd/supervisor instead of cron.
# Copy this file to .env.ses-daemon and combine it with .env.common.
#
# Expected matching Mautic config/local.php transport:
# 'messenger_dsn_email' => 'doctrine://default?queue_name=email',

# Dedicated worker lockfile and log directory
SES_DAEMON_LOCKFILE="./ses-daemon-worker.lock"
SES_DAEMON_LOG_DIR="./logs/ses-worker"
MAX_SES_DAEMON_LOGS=10

# Let the SES plugin handle outbound throttling.
# Keep the transport explicit and long-running, then let the service manager
# restart the worker when needed. The worker consumes transport name "email",
# so the Doctrine transport should use queue_name=email.
SES_DAEMON_MEMORY_LIMIT="512M"

# Optional: restart the worker cleanly every hour via systemd Restart=always.
# SES_DAEMON_TIME_LIMIT=3600
