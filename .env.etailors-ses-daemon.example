# SES-plugin daemon worker example:
# Use this when queue consumption is managed by systemd/supervisor instead of cron.

# PHP interpreter with defined memory limit, check your environment
PHP_INTERPRETER="php8.3 -d memory_limit=1G"

# Path to the Mautic console
PATH_TO_CONSOLE="../public/bin/console"

# Dedicated worker log directory
DAEMON_LOG_DIR="./logs/worker"
MAX_DAEMON_LOGS=10

# Let the SES plugin handle outbound throttling.
# Keep this command effectively long-running and let your service manager restart it if needed.
DAEMON_QUEUE_COMMAND="messenger:consume email --memory-limit=512M"
